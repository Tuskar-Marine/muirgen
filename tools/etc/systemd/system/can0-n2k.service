[Unit]
Description=NMEA2000 CAN Bus Initialization of can0 Interface
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/sbin/ip link set can0 type can bitrate 250000
ExecStart=/sbin/ip link set can0 txqueuelen 1000
ExecStart=/sbin/ip link set can0 restart-ms 100
ExecStart=/sbin/ip link set can0 up
ExecStop=/sbin/ip link set can0 down

[Install]
WantedBy=multi-user.target
